# Market Intelligence - Source Database (PostgreSQL)
# This is the database where scraped listings are stored
SOURCE_DB_URL=postgresql://user:password@host:5432/market_intelligence

# Supabase - Target Database (PostgreSQL direct connection)
# Find this in Supabase Dashboard > Settings > Database > Connection string
TARGET_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
